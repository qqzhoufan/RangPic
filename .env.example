# Copy to .env for local `cargo run`.
# Docker does not read this file. It only needs a host port and a data directory:
#   PORT=17777 DATA_DIR=./rangpic-data docker compose up --build -d

# Required
DATABASE_URL=postgres://rangpic:rangpic@localhost:5432/rangpic?sslmode=disable
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpass

# Optional
BIND_ADDR=0.0.0.0:17777
SITE_NAME=RangPic
# Used to build absolute share/embed links. Leave empty for relative links.
SITE_URL=http://localhost:17777
STORAGE_DIR=./storage
# Per-file upload cap in bytes (default 25 MiB)
MAX_UPLOAD_BYTES=26214400
# Per-user storage quota in bytes (default 5 GiB)
QUOTA_DEFAULT_BYTES=5368709120
# Allow public sign-up
REGISTRATION_OPEN=true
# Session lifetime in hours
SESSION_TTL_HOURS=336
RUST_LOG=info,rangpic=debug
